<?xml version="1.0" encoding="utf-8"?>

<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:mp="http://schemas.microsoft.com/appx/2014/phone/manifest"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  IgnorableNamespaces="uap mp">

  <Identity
    Name="b04fd441-c316-483e-824a-9229bd6288f4"
    Publisher="CN=supchyan"
    Version="1.0.0.0" />

  <mp:PhoneIdentity PhoneProductId="b04fd441-c316-483e-824a-9229bd6288f4" PhonePublisherId="00000000-0000-0000-0000-000000000000"/>

  <Properties>
    <DisplayName>de:things</DisplayName>
    <PublisherDisplayName>supchyan</PublisherDisplayName>
    <Logo>Assets\Icons\Icon.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Universal" MinVersion="10.0.0.0" MaxVersionTested="10.0.0.0" />
  </Dependencies>

  <Resources>
    <Resource Language="x-generate"/>
  </Resources>

  <Applications>
    <Application Id="App"
      Executable="$targetnametoken$.exe"
      EntryPoint="DT.App">
      <uap:VisualElements
        DisplayName="de:things"
        Square44x44Logo="Assets\Icons\Icon.png"
        Description="decentralized things IoT Hololens 2 Showcase App."
        BackgroundColor="transparent" Square150x150Logo="Assets\Icons\Icon.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Icons\SplashScreen.png" ShortName="de:things" Square310x310Logo="Assets\Icons\Icon.png" Square71x71Logo="Assets\Icons\IconLarge.png">
          <uap:ShowNameOnTiles>
            <uap:ShowOn Tile="square150x150Logo"/>
            <uap:ShowOn Tile="wide310x150Logo"/>
            <uap:ShowOn Tile="square310x310Logo"/>
          </uap:ShowNameOnTiles>
        </uap:DefaultTile >
        <uap:SplashScreen Image="Assets\Icons\SplashScreen.png" />
      </uap:VisualElements>
    </Application>
  </Applications>

  <Capabilities>
    <Capability Name="internetClient" />
  </Capabilities>
</Package>